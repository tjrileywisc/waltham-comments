{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "inputs": [
        {
            "id": "name",
            "type": "promptString",
            "description": "meeting to choose"
        }
    ],
    "configurations": [
        {
            "name": "debug audio",
            "type": "debugpy",
            "request": "launch",
            "module": "lib.audio"
        },
        {
            "name": "debug transcription",
            "type": "debugpy",
            "request": "launch",
            "module": "lib.transcription",
            "args": [
                "${input:name}"
            ]
        },
        {
            "name": "debug download",
            "type": "debugpy",
            "request": "launch",
            "program": "main.py",
            "console": "integratedTerminal",
            "args": []
        },
        {
            "name": "debug webserver",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--reload"
            ],
            "env": {
                "DATA_DIR": "../waltham-comments"
            },
            "jinja": true
        }
    ]
}